# Test Supabase project — NEVER point these at production.
# Get these from: Supabase dashboard -> inventory-pro-test -> Project Settings -> API
#
# scripts/lib/testTarget.mjs refuses to run if TEST_SUPABASE_URL resolves to the
# production project ref, so a copy/paste mistake fails loudly instead of writing
# to live business data.

TEST_SUPABASE_URL=https://YOUR-TEST-REF.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
