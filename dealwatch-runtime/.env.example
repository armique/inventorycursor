# Copy this file to .env and enter your own production credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE
# Optional diagnostic fallback only: short-lived Application Token from eBay Developer Portal (~2 hours).
# Prefer EBAY_CLIENT_ID + EBAY_CLIENT_SECRET — the app refreshes those automatically.
# EBAY_APPLICATION_TOKEN=
# Optional: auction reminder five minutes before ending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rate limits (Browse API 429 / "Too many requests") ---
# Full background monitor cycle. With ~40 eBay filters, use 15–30.
MONITOR_INTERVAL_MINUTES=15
# Minimum gap between eBay Browse API calls (milliseconds).
EBAY_MIN_GAP_MS=500
# Pause between each monitored search inside one cycle (milliseconds).
MONITOR_SEARCH_GAP_MS=1500
# How many times to retry a single Browse call after HTTP 429.
EBAY_MAX_RETRIES_ON_429=4
